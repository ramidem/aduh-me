---
import { formatShortDate, noteUrl, type Note } from '../../lib/notes';

interface Props {
	note: Note;
	current?: Note;
	folder?: string;
}

const { note, current, folder } = Astro.props;
const isCurrent = current?.id === note.id;
---

<li>
	<a class="note-row" href={noteUrl(note, folder)} aria-current={isCurrent ? 'true' : undefined}>
		<strong>{note.data.title}</strong>
		<span class="note-row-meta"><time datetime={note.data.date.toISOString()}>{formatShortDate(note.data.date)}</time>{note.data.description}</span>
	</a>
</li>
