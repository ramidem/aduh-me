---
import { ClientRouter } from 'astro:transitions';
import '../styles/notes.css';
import { SITE_AUTHOR, SITE_ROLE, SITE_TAGLINE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	canonical?: string;
	noindex?: boolean;
	jsonLd?: object;
}

const { title, description = SITE_TAGLINE, type = 'website', canonical, noindex = false, jsonLd } = Astro.props;
const canonicalHref = canonical ? new URL(canonical, Astro.site).href : undefined;
const imageHref = new URL('/images/notes/site-icon.png', Astro.site).href;
const homeTitle = `${SITE_AUTHOR} • ${SITE_ROLE}`;
const fullTitle = title ? `${title} • ${SITE_AUTHOR}` : homeTitle;
---

<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icons/android-icon-192x192.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-icon-180x180.png" />
		<link rel="alternate" type="application/rss+xml" title={SITE_AUTHOR} href="/rss.xml" />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="author" content={SITE_AUTHOR} />
		<meta name="description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE_AUTHOR} />
		<meta property="og:title" content={title ?? homeTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageHref} />
		{canonicalHref && <link rel="canonical" href={canonicalHref} />}
		{canonicalHref && <meta property="og:url" content={canonicalHref} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:image" content={imageHref} />
		<title>{fullTitle}</title>
		<link rel="preload" href="/fonts/vollkorn/Vollkorn-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>
